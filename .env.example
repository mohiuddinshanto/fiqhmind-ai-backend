APP_NAME=FiqhMind AI Backend
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL (sync SQLAlchemy engine)
# Cloud/remote: use a real DSN. `postgres://` / `postgresql://` are
# auto-normalised to `postgresql+psycopg://`.
DATABASE_URL=postgresql+psycopg://fiqhmind:fiqhmind@localhost:5432/fiqhmind
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# Redis (cache, rate limits) and Celery broker/backend.
# ---------------------------------------------------------------------------
# Option A — local/self-hosted Redis (`docker compose up -d redis`):
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# ---------------------------------------------------------------------------
# Option B — Upstash Redis (managed). Set the two vars below (never commit
# real tokens!) and comment out the three REDIS_URL/CELERY_* lines above. The
# REST URL + token are auto-derived into a single redis-py `rediss://` URL on
# db 0 (Upstash has one logical database) for cache, rate limits, and Celery.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=
# ---------------------------------------------------------------------------

# Qdrant vector store.
# QDRANT_HOST accepts a full URL (`https://cluster.qdrant.io:6333`) or a bare
# hostname (auto-normalised to `https://<host>:6333`). If QDRANT_URL is set it
# wins. QDRANT_API_KEY is the real secret for a cloud cluster.
QDRANT_HOST=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=fiqh_chunks
QDRANT_VECTOR_SIZE=1024
QDRANT_VECTOR_DISTANCE=Cosine

# Embedding + hybrid search (Phase 8): deterministic | bge_m3 (later phase)
EMBEDDING_PROVIDER=deterministic
VECTOR_RRF_K=60

# Retrieval pipeline (Phase 9): dependency-free defaults | external later
LANGUAGE_DETECTOR_PROVIDER=heuristic
TRANSLATOR_PROVIDER=passthrough
RERANKER_PROVIDER=default
RETRIEVAL_TOP_N=8
RETRIEVAL_CANDIDATES=40
RETRIEVAL_MAX_VARIANTS=5
RETRIEVAL_EVIDENCE_FLOOR=0.05
RETRIEVAL_LLM_EXPANSION_ENABLED=false
RETRIEVAL_RERANKING_ENABLED=true
QUERY_MAX_LENGTH=500

# LLM answer generation (Phase 10 + Phase 11): deterministic | gemini | groq | openrouter
# Groq is wired end-to-end: put your REAL key in .env (never here) and set
# GENERATOR_PROVIDER=groq or rely on the fallback chain.
GENERATOR_PROVIDER=deterministic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OpenRouter free-preview model as the rotating third fallback rung (Phase 11).
# Optional: only used when both primary and first fallback are unavailable.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Fallback chain order: generator_provider first, then these in order.
PROVIDER_FALLBACK_ORDER=gemini,groq,openrouter
GENERATION_MAX_CHUNKS=7
GENERATION_RETRIES=1
GENERATION_REQUEST_TIMEOUT_SECONDS=60
GENERATION_LATENCY_BUDGET_MS=3000

# Rate limits (per Phase 14 defaults)
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_SEARCH_PER_MIN=60
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_INGEST_PER_MIN=5
RATE_LIMIT_EVAL_PER_HOUR=2

# Phase 15 caching (best-effort: app degrades to the uncached path if Redis is down)
CACHE_QA_TTL_SECONDS=86400
CACHE_EMBEDDING_TTL_SECONDS=604800
CACHE_RETRIEVAL_TTL_SECONDS=900
EMBEDDING_BATCH_SIZE=128
EXTRACTION_WORKERS=4
EXTRACTION_CHECKPOINT_PAGES=25

# PDF uploads (Phase 3)
UPLOAD_STORAGE_PATH=storage/uploads
UPLOAD_STORAGE_PROVIDER=local
UPLOAD_MAX_SIZE_BYTES=209715200
UPLOAD_MAX_PAGES=2000
UPLOAD_ALLOWED_MIME=application/pdf
UPLOAD_CHUNK_SIZE=65536
UPLOAD_MAX_FILES_PER_REQUEST=20
