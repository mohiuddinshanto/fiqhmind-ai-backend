# Version control
.git
.gitignore
.github

# Environment & secrets — never bake .env files into images
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Uploaded files (local storage provider) — runtime data, not image content
storage/

# Celery beat state
celerybeat-schedule*
celerybeat.pid
